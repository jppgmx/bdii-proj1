{
  "name": "transporte-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API do transporte universitário de Cajazeiras-PB",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "db:migrate": "node database/migrate.js",
    "test": "node --test test/app.test.js test/config.test.js test/startup.test.js test/validation.test.js test/geocoding.test.js",
    "test:integration": "node --test test/database.integration.test.js",
    "db:seed": "node database/seed.js"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "sequelize": "^6.37.8"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
