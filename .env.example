NODE_ENV=development
API_PORT=3000

# localhost ao executar o backend fora do Docker.
# O Compose define PG_HOST=db no container da aplicação.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=transporte
PG_USER=transporte
PG_PASSWORD=transporte_local
PG_SSL=false

# backend funciona antes da entrega do React.
# Use production quando apps/frontend entregar o build combinado.
APP_BUILD_TARGET=backend
