NODE_ENV=development
API_PORT=3000

# localhost ao executar o backend fora do Docker.
# O Compose define PG_HOST=db no container da aplicação.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=transporte
PG_USER=transporte
PG_PASSWORD=transporte_local
PG_SSL=false

# backend funciona antes da entrega do React.
# Use production quando apps/frontend entregar o build combinado.
APP_BUILD_TARGET=backend

# Serviço compatível com a API de busca do Nominatim. Troque por configuração.
GEOCODING_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=TransporteUniversitarioBDII/0.1 (https://github.com/jppgmx/bdii-proj1)
GEOCODING_TIMEOUT_MS=5000
GEOCODING_CACHE_TTL_SECONDS=86400
